<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.classless.min.css" />
  <link href="/css/style.css" rel="stylesheet" />
  <title>CreatePost</title>
</head>

<body>
  <main>
    <div class="authOptions">
      <h1>Create Post</h1>
      <a role="button" href="/posts">Home</a>
    </div>
    <div class="box">
      <h1>Add a Post</h1>
      <form action="/posts/create" method="post">
        <input type="text" name="title" id="title" placeholder="Title" />
        <input type="text" name="description" id="body" placeholder="Body" />
        <input type="text" name="link" id="link" placeholder="External Link" />
        <input type="text" name="sub" id="sub" placeholder="Chosen Subgroup" />
        <button type="submit">Create</button>
      </form>
    </div>
  </main>
</body>

</html>